plugins {
    agent-deck location="file:~/.nix-profile/share/zellij/plugins/agent-deck.wasm" {
        helper "zellij-agent-deck"
        show_subagents "false"
        auto_size "true"
    }
}

// Keep one hidden instance in each session so lifecycle events are received.
load_plugins {
    agent-deck
}

keybinds {
    shared_except "locked" {
        bind "Alt a" {
            MessagePlugin "agent-deck" {
                name "open"
            }
            SwitchToMode "Normal"
        }
        bind "Alt n" {
            MessagePlugin "agent-deck" {
                name "attention-next"
            }
            SwitchToMode "Normal"
        }
    }
}
